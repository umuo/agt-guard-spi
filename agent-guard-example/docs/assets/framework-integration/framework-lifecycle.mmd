flowchart TD
    B["Agent build：显式引擎优先，否则 SPI 发现工厂"] --> S["每次请求：创建独立根上下文"]
    S --> A["AGENT_INPUT：先检查，再做 RAG / 模板处理"]
    A --> P["准备完整请求：历史、检索上下文、工具与参数"]
    P --> MI["MODEL_INPUT：每次实际模型尝试前"]
    MI --> M["传入有效请求，调用模型"]
    M --> MO["MODEL_OUTPUT：完整响应进入解析与工具调度前"]
    MO --> Q{"有效响应是否有工具调用？"}
    Q -->|有| T["TOOL_INPUT：本轮工具集合、权限与有效参数"]
    T --> X["实际执行工具"]
    X --> O["TOOL_OUTPUT：写入后续模型历史前"]
    O --> N["用有效请求、有效响应与有效工具结果组装下一轮"]
    N --> MI
    Q -->|无| F["AGENT_OUTPUT：解析业务输出后，对外发送前"]
    F --> R["返回有效业务结果"]
