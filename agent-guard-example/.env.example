# OpenAI 兼容的非流式 Chat Completions 接口，模型必须支持工具调用。
# 从项目根目录运行；系统环境变量优先于本文件。无需 export，不支持变量展开。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL_NAME=gpt-4o-mini
# 单次 HTTP 请求超时，单位秒；默认 60。演示关闭重试，避免重复费用。
LLM_TIMEOUT_SECONDS=60
# 相对于运行目录；默认 config/agt-policy.yaml。
AGENTGUARD_AGT_POLICY_PATH=config/agt-policy.yaml
